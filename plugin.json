{
  "manifestVersion": 2,
  "name": "model-health",
  "displayName": "账号模型体检",
  "publisher": "local",
  "version": "0.10.0",
  "description": "选择已有账号，使用 Meow 或 ModelTrace 检测模型行为指纹；独立插件，不改写账号或主服务",
  "license": "PolyForm-Noncommercial-1.0.0",
  "engines": {
    "codex-proxy-rs": ">=3.15.0, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "management": {
      "version": 2
    },
    "maintenance": {
      "version": 1
    }
  },
  "resources": {
    "web/index.html": "text/html",
    "web/app.js": "text/javascript",
    "web/app.css": "text/css",
    "legal/LICENSE": "text/plain",
    "legal/NOTICE": "text/plain",
    "engine-legal/ENGINE-LICENSES.txt": "text/plain",
    "engine-legal/ENGINE-REQUIREMENTS.txt": "text/plain"
  },
  "state": [
    {
      "namespace": "runs",
      "schemaVersion": 2,
      "schema": {
        "type": "object",
        "required": [
          "id",
          "slot",
          "plan",
          "attempts",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 100
          },
          "slot": {
            "type": "integer",
            "minimum": 0,
            "maximum": 15
          },
          "plan": {
            "type": "object"
          },
          "attempts": {
            "type": "array",
            "maxItems": 324
          },
          "status": {
            "enum": [
              "ready",
              "running",
              "paused",
              "completed",
              "stopped"
            ]
          }
        }
      },
      "maximumRecords": 16,
      "maximumBytes": 4194304,
      "maximumValueBytes": 262144,
      "migratesFrom": [
        1
      ]
    },
    {
      "namespace": "schedule",
      "schemaVersion": 4,
      "schema": {
        "type": "object",
        "required": [
          "enabled",
          "model",
          "interval_minutes",
          "accounts",
          "timing",
          "detection",
          "active_account",
          "concurrency"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "model": {
            "type": "string",
            "maxLength": 128
          },
          "interval_minutes": {
            "type": "integer",
            "minimum": 60,
            "maximum": 10080
          },
          "accounts": {
            "type": "array",
            "maxItems": 50
          },
          "timing": {
            "properties": {
              "daily_time": {
                "type": "string",
                "maxLength": 5
              },
              "cron": {
                "type": "string",
                "maxLength": 128
              },
              "timezone": {
                "type": "string",
                "maxLength": 64
              },
              "mode": {
                "enum": [
                  "interval",
                  "daily",
                  "cron"
                ]
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "mode",
              "timezone",
              "daily_time",
              "cron"
            ]
          },
          "detection": {
            "type": "object",
            "required": [
              "method",
              "tier",
              "claimed_model"
            ],
            "additionalProperties": false,
            "properties": {
              "claimed_model": {
                "maxLength": 128,
                "type": "string"
              },
              "tier": {
                "maxLength": 16,
                "type": "string"
              },
              "method": {
                "enum": [
                  "short",
                  "meow",
                  "modeltrace"
                ]
              }
            }
          },
          "active_account": {
            "type": [
              "string",
              "null"
            ]
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      },
      "maximumRecords": 1,
      "maximumBytes": 131072,
      "maximumValueBytes": 65536,
      "migratesFrom": [
        1,
        2,
        3
      ]
    }
  ]
}
